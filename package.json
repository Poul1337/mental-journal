{
	"name": "mental-journal",
	"private": true,
	"scripts": {
		"build": "turbo run build",
		"dev": "pnpm docker:up && turbo run dev",
		"docker:up": "docker compose -f docker/docker-compose.yml up -d --wait",
		"docker:down": "docker compose -f docker/docker-compose.yml down",
		"check-types": "turbo run check-types",
		"db:generate": "turbo run db:generate --filter=api",
		"db:migrate": "turbo run db:migrate --filter=api",
		"db:push": "turbo run db:push --filter=api",
		"db:studio": "turbo run db:studio --filter=api",
		"api:test": "turbo run test --filter=api",
		"prisma:format": "pnpm --filter api prisma:format",
		"format": "prettier . --write",
		"format:check": "prettier . --check",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"prepare": "husky",
		"check": "pnpm lint && pnpm format:check"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.1",
		"eslint": "^9.39.1",
		"eslint-plugin-simple-import-sort": "^14.0.0",
		"eslint-plugin-unused-imports": "^4.4.1",
		"husky": "^9.1.7",
		"lint-staged": "^17.3.0",
		"prettier": "^3.7.4",
		"turbo": "^2.9.18",
		"typescript": "5.9.2",
		"typescript-eslint": "^8.50.0"
	},
	"lint-staged": {
		"*.{js,mjs,cjs,ts,tsx}": [
			"eslint --fix",
			"prettier --write"
		],
		"*.{json,md,yml,yaml,css,scss}": [
			"prettier --write"
		]
	},
	"packageManager": "pnpm@9.0.0",
	"engines": {
		"node": ">=18"
	}
}
